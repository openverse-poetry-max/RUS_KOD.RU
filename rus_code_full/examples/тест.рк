# Пример программы на РусКоде с использованием библиотек

использовать math
использовать random
использовать datetime

написать_строку("=== Тест РусКод ===")

# Переменные
пусть x равна 10
пусть y равна 20
пусть сумма равна плюс(x, y)
написать_строку("Сумма:", сумма)

# Математика
пусть корень_из_16 равна корень(16)
написать_строку("Корень из 16:", корень_из_16)

пусть степень равна степень(2, 8)
написать_строку("2 в степени 8:", степень)

# Строки
пусть текст равна "Привет, мир!"
написать_строку("Текст:", текст)
написать_строку("Длина:", длина(текст))
написать_строку("Верхний регистр:", верхний_регистр(текст))

# Списки
пусть числа равна список(1, 2, 3, 4, 5)
написать_строку("Числа:", числа)
написать_строку("Сумма чисел:", сумма(числа))
написать_строку("Среднее:", среднее(числа))

# Условия
пусть возраст равна 25
если больше(возраст, 18) то
    написать_строку("Совершеннолетний")
иначе
    написать_строку("Несовершеннолетний")

# Цикл повторить
написать_строку("\nЦикл повторить 5 раз:")
повторить 5 раз
    написать_строку("Итерация", счетчик + 1)

# Случайные числа
пусть случайное равна случайное_целое(1, 100)
написать_строку("\nСлучайное число от 1 до 100:", случайное)

# Дата и время
пусть сейчас равна сейчас()
написать_строку("Текущая дата и время:", сейчас)

# Использование библиотеки math через адаптер
написать_строку("\n=== Библиотека Math ===")
пусть пи равна 3.14159
пусть синус_пи равна синус(пи)
написать_строку("sin(pi):", синус_пи)

пусть логарифм равна логарифм(100, 10)
написать_строку("log10(100):", логарифм)

написать_строку("\n=== Программа завершена ===")
