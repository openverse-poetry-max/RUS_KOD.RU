# Графический пример на РусКод
# Рисование различных фигур с использованием графической библиотеки

использовать graphics_lib

написать_строку("Создание графического изображения...")

# Создаём холст
пусть холст равна создать_холст(800, 600)

# Устанавливаем цвета
установить_цвет(красный())
нарисовать_круг(400, 300, 100, красный(), жёлтый())

установить_цвет(синий())
нарисовать_прямоугольник(200, 200, 200, 150, синий(), голубой())

установить_цвет(зелёный())
нарисовать_треугольник(500, 100, 600, 250, 400, 250, зелёный(), жёлтый())

# Рисуем звезду
установить_цвет(оранжевый())
нарисовать_звезду(300, 450, 80, 40, 5, оранжевый(), жёлтый())

# Рисуем линии
установить_толщину(3)
нарисовать_линию(50, 50, 750, 550, чёрный(), 3)
нарисовать_линию(750, 50, 50, 550, чёрный(), 3)

# Добавляем текст
нарисовать_текст(400, 50, "РусКод Графика", фиолетовый(), "Arial", 24)
нарисовать_текст(400, 580, "Создано на РусКод", серый(), "Arial", 14)

# Получаем информацию о элементах
пусть количество равна количество_элементов()
написать_строку("Нарисовано элементов:", количество)

# Сохраняем в SVG
сохранить_svg("рисунок.svg")
написать_строку("Изображение сохранено в файл рисунок.svg")

написать_строку("Графическая программа завершена!")
