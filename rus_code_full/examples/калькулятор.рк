написать_строку()

пусть операция равна спросить("Выберите операцию (плюс, минус, умножить, разделить): ")
пусть число1 равна спросить_число("Введите первое число: ")
пусть число2 равна спросить_число("Введите второе число: ")

пусть результат равна 0

если равно(операция, "плюс") то
    пусть результат равна плюс(число1, число2)
иначе если равно(операция, "минус") то
    пусть результат равна минус(число1, число2)
иначе если равно(операция, "умножить") то
    пусть результат равна умножить(число1, число2)
иначе если равно(операция, "разделить") то
    пусть результат равна разделить(число1, число2)
иначе
    написать_строку("Неизвестная операция!")

если больше(результат, 0) или равно(результат, 0) то
    написать_строку("Результат:", результат)

