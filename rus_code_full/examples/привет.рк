# Пример программы на РусКод
# Простая демонстрация возможностей языка

написать_строку("Привет, мир!")
написать_строку("Добро пожаловать в РусКод!")

пусть имя равна "Алексей"
пусть возраст равна 25

написать_строку("Меня зовут:", имя)
написать_строку("Мой возраст:", возраст)

# Математические операции
пусть число1 равна 10
пусть число2 равна 20
пусть сумма равна плюс(число1, число2)
пусть произведение равна умножить(число1, число2)

написать_строку("Сумма чисел", число1, "и", число2, "равна:", сумма)
написать_строку("Произведение:", произведение)

# Условия
если больше(возраст, 18) то
    написать_строку(имя, "совершеннолетний")
иначе
    написать_строку(имя, "несовершеннолетний")

# Циклы
написать_строку("Считаем до 5:")
пусть i равна 1
пока меньше(i, 6) делать
    написать_строку(i)
    пусть i равна плюс(i, 1)

# Работа со строками
пусть текст равна "Привет, РусКод!"
написать_строку("Оригинал:", текст)
написать_строку("Длина:", длина(текст))
написать_строку("В верхнем регистре:", верхний_регистр(текст))
написать_строку("В нижнем регистре:", нижний_регистр(текст))

# Списки
пусть числа равна создать_список(1, 2, 3, 4, 5)
написать_строку("Список чисел:", числа)
написать_строку("Сумма элементов:", сумма(числа))
написать_строку("Среднее значение:", среднее(числа))

# Дата и время
написать_строку("Текущая дата:", текущая_дата())
написать_строку("Текущее время:", текущее_время())

написать_строку("Программа завершена!")
