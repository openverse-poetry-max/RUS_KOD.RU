# Простая программа на РусКоде

написать_строку("Привет, мир!")

пусть x равна 10
пусть y равна 20
пусть сумма равна плюс(x, y)

написать_строку("Сумма чисел", x, "и", y, "=", сумма)

если больше(сумма, 25) то
    написать_строку("Сумма больше 25")
иначе
    написать_строку("Сумма меньше или равна 25")

повторить 3 раз
    написать_строку("Повторение", счетчик + 1)
