    def выполнить(self, код: str):
        """Выполняет код на языке РусКод"""
        строки = код.strip().split('\n')
        i = 0
        
        while i < len(строки):
            строка = строки[i].strip()
            
            # Пропускаем пустые строки и комментарии
            if not строка or строка.startswith('#') or строка.startswith('//'):
                i += 1
                continue
            
            # Обработка команды "использовать"
            if строка.startswith('использовать '):
                self._обработать_импорт(строка)
                i += 1
                continue
            
            # Обработка команды "функция"
            if строка.startswith('функция '):
                i = self._обработать_функцию(строки, i)
                continue
            
            # Обработка условия "если"
            if строка.startswith('если '):
                i = self._обработать_условие(строки, i)
                continue
            
            # Обработка цикла "повторить N раз"
            if строка.startswith('повторить '):
                i = self._обработать_цикл_повторить(строки, i)
                continue
            
            # Обработка цикла "пока"
            if строка.startswith('пока '):
                i = self._обработать_цикл_пока(строки, i)
                continue
            
            # Обработка цикла "для"
            if строка.startswith('для '):
                i = self._обработать_цикл_для(строки, i)
                continue
            
            # Обработка присваивания
            if ' равна ' in строка or ' равно ' in строка:
                self._обработать_присваивание(строка)
                i += 1
                continue
            
            # Обработка вызова функции
            if '(' in строка and ')' in строка:
                self._вызвать_функцию_из_строки(строка)
                i += 1
                continue
            
            i += 1
    
    def _обработать_импорт(self, строка: str):
        """Обрабатывает команду импорта библиотеки"""
        части = строка.replace('использовать ', '').strip().split(' как ')
        имя_модуля = части[0].strip()
        псевдоним = части[1].strip() if len(части) > 1 else None
        
        try:
            # Пробуем импортировать через адаптер
            модуль = self.адаптер.импортировать_модуль(имя_модуля, псевдоним)
            
            if псевдоним:
                self.библиотеки[псевдоним] = модуль
                self.переменные[псевдоним] = модуль
            else:
                русское_имя = self.адаптер.словарь_перевода.get(имя_модуля, имя_модуля)
                self.библиотеки[русское_имя] = модуль
                self.переменные[русское_имя] = модуль
            
            # Добавляем функции модуля в пространство имен
            обертка = self.адаптер.создать_обертку_модуля(модуль, имя_модуля)
            for имя, функция in обертка.items():
                if имя not in self.функции:
                    self.функции[имя] = функция
        
        except ImportError as e:
            print(f"Ошибка импорта: {e}")
    
    def _обработать_функцию(self, строки: List[str], start_index: int) -> int:
        """Обрабатывает объявление функции"""
        строка = строки[start_index]
        
        # Парсим: функция имя(параметры):
        match = re.match(r'функция\s+(\w+)\s*\(([^)]*)\)\s*:', строка)
        if not match:
            # Пробуем без двоеточия
            match = re.match(r'функция\s+(\w+)\s*\(([^)]*)\)', строка)
        
        if match:
            имя = match.group(1)
            параметры = [p.strip() for p in match.group(2).split(',') if p.strip()]
            
            # Находим тело функции
            тело = []
            i = start_index + 1
            базовая_индентация = len(строка) - len(строка.lstrip())
            
            while i < len(строки):
                текущая = строки[i]
                if not текущая.strip():
                    i += 1
                    continue
                
                текущая_индентация = len(текущая) - len(текущая.lstrip())
                
                if текущая_индентация <= базовая_индентация and текущая.strip():
                    break
                
                тело.append(текущая)
                i += 1
            
            # Создаем функцию
            def создать_функцию(парам, тело_функции):
                def внутренняя_функция(*args):
                    # Сохраняем текущие переменные
                    сохраненные = self.переменные.copy()
                    
                    # Устанавливаем параметры
                    for j, param in enumerate(парам):
                        if j < len(args):
                            self.переменные[param] = args[j]
                    
                    # Выполняем тело функции
                    self.выполнить('\n'.join(тело_функции))
                    
                    # Возвращаем результат (если есть)
                    результат = self.переменные.get('результат', None)
                    
                    # Восстанавливаем переменные
                    self.переменные = сохраненные
                    
                    return результат
                
                return внутренняя_функция
            
            self.функции[имя] = создать_функцию(параметры, тело)
            return i
        
        return start_index + 1
    
    def _обработать_условие(self, строки: List[str], start_index: int) -> int:
        """Обрабатывает условный оператор если"""
        строка = строки[start_index]
        
        # Парсим условие
        match = re.match(r'если\s+(.+?)\s+то\s*:?|если\s+(.+)', строка)
        if match:
            условие_текст = match.group(1) or match.group(2)
            
            # Находим ветку "то"
            тело_то = []
            тело_иначе = []
            i = start_index + 1
            базовая_индентация = len(строка) - len(строка.lstrip())
            в_ветке_иначе = False
            
            while i < len(строки):
                текущая = строки[i]
                
                if not текущая.strip():
                    i += 1
                    continue
                
                текущая_индентация = len(текущая) - len(текущая.lstrip())
                
                # Проверяем на "иначе"
                if 'иначе:' in текущая or текущая.strip() == 'иначе':
                    в_ветке_иначе = True
                    i += 1
                    continue
                
                if текущая_индентация <= базовая_индентация and текущая.strip():
                    if not в_ветке_иначе and (текущая.startswith('иначе') or 'иначе' in текущая):
                        в_ветке_иначе = True
                        i += 1
                        continue
                    break
                
                if в_ветке_иначе:
                    тело_иначе.append(текущая)
                else:
                    тело_то.append(текущая)
                
                i += 1
            
            # Вычисляем условие
            try:
                результат_условия = self._вычислить_выражение(условие_текст)
                
                if результат_условия:
                    self.выполнить('\n'.join(тело_то))
                else:
                    self.выполнить('\n'.join(тело_иначе))
            
            except Exception as e:
                print(f"Ошибка в условии: {e}")
            
            return i
        
        return start_index + 1
    
    def _обработать_цикл_повторить(self, строки: List[str], start_index: int) -> int:
        """Обрабатывает цикл повторить N раз"""
        строка = строки[start_index]
        
        match = re.match(r'повторить\s+(\d+)\s+раз\s*:?', строка)
        if match:
            количество = int(match.group(1))
            
            тело = []
            i = start_index + 1
            базовая_индентация = len(строка) - len(строка.lstrip())
            
            while i < len(строки):
                текущая = строки[i]
                
                if not текущая.strip():
                    i += 1
                    continue
                
                текущая_индентация = len(текущая) - len(текущая.lstrip())
                
                if текущая_индентация <= базовая_индентация and текущая.strip():
                    break
                
                тело.append(текущая)
                i += 1
            
            # Выполняем цикл
            for j in range(количество):
                self.переменные['счетчик'] = j
                self.выполнить('\n'.join(тело))
            
            return i
        
        return start_index + 1
    
    def _обработать_цикл_пока(self, строки: List[str], start_index: int) -> int:
        """Обрабатывает цикл пока"""
        строка = строки[start_index]
        
        match = re.match(r'пока\s+(.+?)\s*:?', строка)
        if match:
            условие_текст = match.group(1)
            
            тело = []
            i = start_index + 1
            базовая_индентация = len(строка) - len(строка.lstrip())
            
            while i < len(строки):
                текущая = строки[i]
                
                if not текущая.strip():
                    i += 1
                    continue
                
                текущая_индентация = len(текущая) - len(текущая.lstrip())
                
                if текущая_индентация <= базовая_индентация and текущая.strip():
                    break
                
                тело.append(текущая)
                i += 1
            
            # Выполняем цикл
            макс_итераций = 10000
            итерация = 0
            
            while итерация < макс_итераций:
                try:
                    результат = self._вычислить_выражение(условие_текст)
                    if not результат:
                        break
                except:
                    break
                
                self.выполнить('\n'.join(тело))
                итерация += 1
            
            return i
        
        return start_index + 1
    
    def _обработать_цикл_для(self, строки: List[str], start_index: int) -> int:
        """Обрабатывает цикл для"""
        строка = строки[start_index]
        
        match = re.match(r'для\s+(\w+)\s+в\s+(.+?)\s*:?', строка)
        if match:
            переменная = match.group(1)
            выражение_списка = match.group(2)
            
            тело = []
            i = start_index + 1
            базовая_индентация = len(строка) - len(строка.lstrip())
            
            while i < len(строки):
                текущая = строки[i]
                
                if not текущая.strip():
                    i += 1
                    continue
                
                текущая_индентация = len(текущая) - len(текущая.lstrip())
                
                if текущая_индентация <= базовая_индентация and текущая.strip():
                    break
                
                тело.append(текущая)
                i += 1
            
            # Получаем список
            try:
                список = self._вычислить_выражение(выражение_списка)
                
                if isinstance(список, (list, tuple, set)):
                    for элемент in список:
                        self.переменные[переменная] = элемент
                        self.выполнить('\n'.join(тело))
                elif isinstance(список, dict):
                    for ключ in список:
                        self.переменные[переменная] = ключ
                        self.выполнить('\n'.join(тело))
            
            except Exception as e:
                print(f"Ошибка в цикле для: {e}")
            
            return i
        
        return start_index + 1
    
    def _обработать_присваивание(self, строка: str):
        """Обрабатывает присваивание переменной"""
        # Разделяем по "равна" или "равно"
        if ' равна ' in строка:
            части = строка.split(' равна ', 1)
        elif ' равно ' in строка:
            части = строка.split(' равно ', 1)
        else:
            return
        
        имя = части[0].strip()
        значение_текст = части[1].strip()
        
        # Проверяем, не является ли значение вызовом функции
        match = re.match(r'(\w+)\s*\((.*)\)$', значение_текст)
        if match:
            имя_функции = match.group(1)
            аргументы_текст = match.group(2)
            
            аргументы = []
            if аргументы_текст.strip():
                глубина = 0
                текущий = ""
                for символ in аргументы_текст:
                    if символ in '([{':
                        глубина += 1
                    elif символ in ')]}':
                        глубина -= 1
                    
                    if символ == ',' and глубина == 0:
                        аргументы.append(self._вычислить_выражение(текущий.strip()))
                        текущий = ""
                    else:
                        текущий += символ
                
                if текущий.strip():
                    аргументы.append(self._вычислить_выражение(текущий.strip()))
            
            значение = self._вызвать_функцию(имя_функции, аргументы)
        else:
            # Вычисляем значение
            значение = self._вычислить_выражение(значение_текст)
        
        # Сохраняем в переменные
        self.переменные[имя] = значение
    
    def _вычислить_выражение(self, выражение: str) -> Any:
        """Вычисляет значение выражения"""
        выражение = выражение.strip()
        
        # Если это число
        try:
            if '.' in выражение:
                return float(выражение)
            return int(выражение)
        except ValueError:
            pass
        
        # Если это строка в кавычках
        if (выражение.startswith('"') and выражение.endswith('"')) or \
           (выражение.startswith("'") and выражение.endswith("'")):
            return выражение[1:-1]
        
        # Если это логическое значение
        if выражение == 'истина' or выражение == 'True':
            return True
        if выражение == 'ложь' or выражение == 'False':
            return False
        if выражение == 'ничто' or выражение == 'None':
            return None
        
        # Если это переменная
        if выражение in self.переменные:
            return self.переменные[выражение]
        
        # Если это вызов функции
        match = re.match(r'(\w+)\s*\((.*)\)$', выражение)
        if match:
            имя_функции = match.group(1)
            аргументы_текст = match.group(2)
            
            аргументы = []
            if аргументы_текст.strip():
                # Разделяем аргументы
                глубина = 0
                текущий = ""
                for символ in аргументы_текст:
                    if символ in '([{':
                        глубина += 1
                    elif символ in ')]}':
                        глубина -= 1
                    
                    if символ == ',' and глубина == 0:
                        аргументы.append(self._вычислить_выражение(текущий.strip()))
                        текущий = ""
                    else:
                        текущий += символ
                
                if текущий.strip():
                    аргументы.append(self._вычислить_выражение(текущий.strip()))
            
            # Вызываем функцию
            return self._вызвать_функцию(имя_функции, аргументы)
        
        # Если это бинарная операция
        for оператор in [' или ', ' и ', ' >= ', ' <= ', ' == ', ' != ', ' > ', ' < ', ' + ', ' - ', ' * ', ' / ', ' ** ']:
            if оператор in выражение:
                части = выражение.split(оператор, 1)
                if len(части) == 2:
                    левый = self._вычислить_выражение(части[0])
                    правый = self._вычислить_выражение(части[1])
                    
                    оператор_чистый = оператор.strip()
                    if оператор_чистый == '+':
                        return левый + правый
                    elif оператор_чистый == '-':
                        return левый - правый
                    elif оператор_чистый == '*':
                        return левый * правый
                    elif оператор_чистый == '/':
                        return левый / правый if правый != 0 else 0
                    elif оператор_чистый == '**':
                        return левый ** правый
                    elif оператор_чистый == '>':
                        return левый > правый
                    elif оператор_чистый == '<':
                        return левый < правый
                    elif оператор_чистый == '>=':
                        return левый >= правый
                    elif оператор_чистый == '<=':
                        return левый <= правый
                    elif оператор_чистый == '==':
                        return левый == правый
                    elif оператор_чистый == '!=':
                        return левый != правый
                    elif оператор_чистый == 'и':
                        return левый and правый
                    elif оператор_чистый == 'или':
                        return левый or правый
        
        # Возвращаем как есть (возможно это имя переменной)
        return выражение
    
    def _вызвать_функцию(self, имя: str, аргументы: List[Any]) -> Any:
        """Вызывает функцию по имени"""
        if имя in self.функции:
            функция = self.функции[имя]
            try:
                return функция(*аргументы)
            except Exception as e:
                print(f"Ошибка при вызове функции '{имя}': {e}")
                return None
        else:
            print(f"Функция '{имя}' не найдена")
            return None
    
    def _вызвать_функцию_из_строки(self, строка: str):
        """Вызывает функцию из строки кода"""
        match = re.match(r'(\w+)\s*\((.*)\)$', строка.strip())
        if match:
            имя = match.group(1)
            аргументы_текст = match.group(2)
            
            аргументы = []
            if аргументы_текст.strip():
                глубина = 0
                текущий = ""
                for символ in аргументы_текст:
                    if символ in '([{':
                        глубина += 1
                    elif символ in ')]}':
                        глубина -= 1
                    
                    if символ == ',' and глубина == 0:
                        аргументы.append(self._вычислить_выражение(текущий.strip()))
                        текущий = ""
                    else:
                        текущий += символ
                
                if текущий.strip():
                    аргументы.append(self._вычислить_выражение(текущий.strip()))
            
            self._вызвать_функцию(имя, аргументы)


