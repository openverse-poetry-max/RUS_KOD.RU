    def _написать_строку(self, *args, **kwargs):
        """Вывод строки с переводом строки"""
        разделитель = kwargs.get('разделитель', ' ')
        окончание = kwargs.get('окончание', '\n')
        текст = разделитель.join(map(str, args))
        вывод = текст + окончание
        print(вывод, end='')
        self.результат_выполнения.append(вывод)
    
    def _написать(self, *args, **kwargs):
        """Вывод строки без перевода строки"""
        разделитель = kwargs.get('разделитель', ' ')
        текст = разделитель.join(map(str, args))
        print(текст, end='')
        self.результат_выполнения.append(текст)
    
    def _спросить(self, подсказка=""):
        """Запрос ввода от пользователя"""
        try:
            ввод = input(подсказка)
            return ввод
        except EOFError:
            return ""
    
    def _добавить_в_список(self, lst, item):
        """Добавить элемент в список"""
        if isinstance(lst, list):
            lst.append(item)
        return lst
    
    def _удалить_из_списка(self, lst, item):
        """Удалить элемент из списка"""
        if isinstance(lst, list) and item in lst:
            lst.remove(item)
        return lst
    
    def _вставить_в_список(self, lst, index, item):
        """Вставить элемент в список по индексу"""
        if isinstance(lst, list):
            lst.insert(int(index), item)
        return lst
    
    def _очистить_список(self, lst):
        """Очистить список"""
        if isinstance(lst, list):
            lst.clear()
        return lst
    
    def _выход(self, код=0):
        """Выход из программы"""
        sys.exit(int(код))
    
